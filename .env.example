# GitHub OAuth (optional - enables "Login" button with device flow)
# Create an OAuth App at https://github.com/settings/developers
# Set "Device flow" enabled; no callback URL needed for device flow
VITE_GH_CLIENT_ID=
# Base URL of the aarya-subscribe Worker — also used to build the redirect_uri
# for the Google login flow below (same Worker handles both).
VITE_GH_OAUTH_PROXY=

# Google OAuth (optional — enables "Login with Google"). Create a Client ID at
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID →
# Web application, scoped to `openid email profile`. Redirect URI is the
# VITE_GH_OAUTH_PROXY Worker URL below + /oauth/google/callback.
VITE_GOOGLE_CLIENT_ID=

# Microsoft login is deferred — no Entra app registered yet. When it's added,
# it'll need a VITE_MS_CLIENT_ID here in the same style as Google above.

# GitHub fine-grained PAT — for live stats on Home page (rate-limit uplift only)
# Without token: 60 req/hr (sufficient for low-traffic sites)
# With token:   5000 req/hr
# ⚠️  SECURITY: This token is bundled into the client JS and visible in DevTools.
#    Use a fine-grained PAT with NO repository permissions and NO OAuth scopes.
#    Create at: https://github.com/settings/personal-access-tokens/new
#    Set ALL permissions to "No access". Token is used only for rate-limit uplift.
VITE_GH_TOKEN=

# GitHub Pages base path (set automatically by deploy workflow)
# VITE_REPO_BASE=/ajch_cluade_architect/

# Google Analytics 4 — cookieless mode (Issue #14)
# Create property at analytics.google.com → copy Measurement ID (G-XXXXXXXXXX)
# No cookies set; storage: 'none' mode — no consent banner required
VITE_GA_MEASUREMENT_ID=

# GA4 proxy Worker (/monitoring dashboard) — Worker URL from
# `wrangler deploy --config wrangler.ga4.toml` output. Safe to bundle: the URL
# grants nothing on its own, the Worker's own owner-gated GitHub auth is the
# real boundary (see workers/ga4-proxy.ts).
VITE_GA4_PROXY_URL=

# Dual-channel subscribe (Issue #82) — Cloudflare Worker + public Gist stats
# Worker URL from `wrangler deploy` output (https://aarya-subscribe.*.workers.dev)
VITE_SUBSCRIBE_WORKER_URL=
# Public stats Gist ID — the Gist ID (not full URL) of aarya-stats.json
# Safe to bundle: public Gist, contains only aggregate counts (no PII)
VITE_STATS_GIST_ID=

# Cloudflare Web Analytics beacon token (cookieless, additive to GA4/GA proxy)
# Cloudflare dash → aaryaai.dev zone → Analytics & Logs → Web Analytics → "Add site"
# This is a site token embedded in every page load, not a secret — safe to bundle.
# Left blank, index.html's beacon script just no-ops.
VITE_CF_BEACON_TOKEN=

# Cloudflare operational-metrics proxy Worker (/admin/monitoring "Cloudflare" tab)
# Worker URL from `wrangler deploy --config wrangler.cf-monitor.toml` output. Safe to
# bundle: the URL grants nothing on its own — the Worker's owner-gated GitHub auth is
# the real boundary (see workers/cloudflare-proxy.ts).
VITE_CF_MONITOR_PROXY_URL=