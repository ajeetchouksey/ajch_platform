{
  "name": "ajch_platform",
  "private": true,
  "version": "3.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-rss.mjs",
    "build": "tsc -b && vite build && node scripts/generate-og-shells.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky || true",
    "validate-content": "node scripts/validate-content.mjs",
    "health": "node scripts/content-health-report.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "public/content/**/*.json": [
      "node scripts/validate-content.mjs"
    ],
    "public/content/**/*.md": [
      "node scripts/validate-content.mjs"
    ]
  },
  "dependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "wrangler": "^4.124.0"
  }
}
